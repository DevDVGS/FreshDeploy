    },
    "node_modules/@devdags/freshdeploy-adapters": {
      "resolved": "packages/adapters",
      "link": true
    },
    "node_modules/@devdags/freshdeploy-core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@devdags/freshdeploy-widget": {
      "resolved": "packages/widget",
      "link": true
    },
    "packages/adapters": {
      "name": "@devdags/freshdeploy-adapters",
      "version": "0.5.0-beta.1",
      "license": "MIT",
      "engines": {
        "node": ">=20"
      }
    },
    "packages/cli": {
      "name": "@devdags/freshdeploy",
      "version": "0.5.0-beta.1",
      "license": "MIT",
      "bin": {
        "freshdeploy": "bin/freshdeploy.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/core": {
      "name": "@devdags/freshdeploy-core",
      "version": "0.5.0-beta.1",
      "license": "MIT",
      "engines": {
        "node": ">=20"
      }
    },
    "packages/widget": {
      "name": "@devdags/freshdeploy-widget",
      "version": "0.5.0-beta.1",
      "license": "MIT"
    }
  }
}
