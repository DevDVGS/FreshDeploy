{
  "name": "freshdeploy-monorepo",
  "version": "0.5.0-beta.1",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "freshdeploy-monorepo",
      "version": "0.5.0-beta.1",
      "workspaces": [
        "packages/*"
      ],
